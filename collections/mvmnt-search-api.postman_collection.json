              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"objects\": [\n    \"VENDOR\",\n    \"VENDOR\"\n  ],\n  \"pagination\": {\n    \"pageNumber\": 1,\n    \"pageSize\": 50\n  }\n}",
